# Copy to .env on the server (never commit .env).  cp .env.example .env && nano .env

# Public address, without https:// — e.g. monedu.duckdns.org
DOMAIN=

# Database password. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Login signing key (≥ 32 bytes). Generate: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# Kakao login (leave empty to hide the Kakao button). From Kakao Developers.
# Register this Redirect URI there:  https://<DOMAIN>/api/v1/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# DuckDNS (free address). Token from https://www.duckdns.org after signing in.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
