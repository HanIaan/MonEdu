# Copy to .env (never commit .env). Used by infra/docker-compose.yml and local runs.

# ── PostgreSQL ──
POSTGRES_DB=study_monitor
POSTGRES_USER=study_monitor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# ── Spring Boot (backend) ──
DB_URL=jdbc:postgresql://localhost:5433/study_monitor
DB_USERNAME=study_monitor
DB_PASSWORD=change-me-local-only
# >= 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=
# v1.3: production should use PT15M (refresh cookie renews it); dev default PT12H.
JWT_TTL=PT12H
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Refresh token (HttpOnly cookie sm_rt). AUTH_COOKIE_SECURE=true in production (HTTPS).
REFRESH_TTL=P14D
REFRESH_REUSE_GRACE=PT30S
AUTH_COOKIE_SECURE=false
AGREEMENTS_VERSION=2026-11-04
# Trust X-Forwarded-For (last hop) for per-IP throttling only behind your own reverse proxy.
TRUSTED_PROXY=false
AUTH_IP_LIMIT_PER_MINUTE=30
REFRESH_IP_LIMIT_PER_MINUTE=120
FRONTEND_BASE_URL=http://localhost:3000

# Kakao login (optional; disabled when empty). Values from Kakao Developers — never commit them.
# See docs/kakao-setup.md.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# Demo accounts (dev only). Adds classpath:db/seed to Flyway locations.
SEED_DEMO_DATA=true
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ── Next.js (frontend) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Show the demo-account hint on the login page (dev/demo only).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=
